{
  "name": "simulador-c6auto-automation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "start": "node dist/server.js",
    "playwright:install": "npx --yes playwright install --with-deps",
    "docker:up": "docker compose up --attach automind-simulador",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f automind-simulador"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "playwright": "^1.48.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.14",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.12.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
